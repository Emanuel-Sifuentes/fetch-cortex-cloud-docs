{
  "name": "fetch-cortex-docs",
  "version": "1.0.0",
  "description": "Fetch Cortex tech docs from Fluid Topics and convert to Markdown",
  "private": true,
  "scripts": {
    "fetch": "node scripts/fetch_fluidtopics.js",
    "fetch:cloud": "node scripts/fetch_fluidtopics.js --product cloud",
    "fetch:xdr": "node scripts/fetch_fluidtopics.js --product xdr",
    "fetch:xsiam": "node scripts/fetch_fluidtopics.js --product xsiam",
    "fetch:gateway": "node scripts/fetch_fluidtopics.js --product gateway",
    "fetch:agentix": "node scripts/fetch_fluidtopics.js --product agentix",
    "combine": "node scripts/generate_combined.js",
    "combine:cloud": "node scripts/generate_combined.js --product cloud",
    "combine:xdr": "node scripts/generate_combined.js --product xdr",
    "combine:xsiam": "node scripts/generate_combined.js --product xsiam",
    "combine:gateway": "node scripts/generate_combined.js --product gateway",
    "combine:agentix": "node scripts/generate_combined.js --product agentix",
    "fix": "node scripts/fix.js",
    "fix:cloud": "node scripts/fix.js --product cloud",
    "fix:xdr": "node scripts/fix.js --product xdr",
    "fix:xsiam": "node scripts/fix.js --product xsiam",
    "fix:gateway": "node scripts/fix.js --product gateway",
    "fix:agentix": "node scripts/fix.js --product agentix",
    "audit:headings": "node scripts/audit_headings.js",
    "audit:toc": "node scripts/audit_toc_vs_headings.js",
    "toc:table": "node scripts/generate_toc_table.js",
    "test": "node --test scripts/generate_combined.test.js scripts/fetch_fluidtopics.test.js"
  },
  "dependencies": {
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
