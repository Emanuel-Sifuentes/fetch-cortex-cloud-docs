{
  "name": "fetch-cortex-docs",
  "version": "1.0.0",
  "description": "Fetch Cortex tech docs from Fluid Topics and convert to Markdown",
  "private": true,
  "scripts": {
    "fetch": "node scripts/fetch_fluidtopics.js",
    "fetch:cloud": "node scripts/fetch_fluidtopics.js --product cloud",
    "fetch:xdr": "node scripts/fetch_fluidtopics.js --product xdr",
    "fetch:xsiam": "node scripts/fetch_fluidtopics.js --product xsiam",
    "fetch:gateway": "node scripts/fetch_fluidtopics.js --product gateway",
    "fetch:agentix": "node scripts/fetch_fluidtopics.js --product agentix",
    "combine": "node scripts/generate_combined.js",
    "combine:cloud": "node scripts/generate_combined.js --product cloud",
    "combine:xdr": "node scripts/generate_combined.js --product xdr",
    "combine:xsiam": "node scripts/generate_combined.js --product xsiam",
    "combine:gateway": "node scripts/generate_combined.js --product gateway",
    "combine:agentix": "node scripts/generate_combined.js --product agentix",
    "fix": "node scripts/fix.js",
    "fix:cloud": "node scripts/fix.js --product cloud",
    "fix:xdr": "node scripts/fix.js --product xdr",
    "fix:xsiam": "node scripts/fix.js --product xsiam",
    "fix:gateway": "node scripts/fix.js --product gateway",
    "fix:agentix": "node scripts/fix.js --product agentix",
    "check": "node scripts/check.js",
    "check:cloud": "node scripts/check.js --product cloud",
    "check:xdr": "node scripts/check.js --product xdr",
    "check:xsiam": "node scripts/check.js --product xsiam",
    "check:gateway": "node scripts/check.js --product gateway",
    "check:agentix": "node scripts/check.js --product agentix",
    "snapshot": "node scripts/snapshot.js",
    "snapshot:cloud": "node scripts/snapshot.js --product cloud",
    "snapshot:xdr": "node scripts/snapshot.js --product xdr",
    "snapshot:xsiam": "node scripts/snapshot.js --product xsiam",
    "snapshot:gateway": "node scripts/snapshot.js --product gateway",
    "snapshot:agentix": "node scripts/snapshot.js --product agentix",
    "split": "python scripts/split_combined.py",
    "split:cloud": "python scripts/split_combined.py --product cloud",
    "split:xdr": "python scripts/split_combined.py --product xdr",
    "split:xsiam": "python scripts/split_combined.py --product xsiam",
    "split:gateway": "python scripts/split_combined.py --product gateway",
    "split:agentix": "python scripts/split_combined.py --product agentix",
    "audit:headings": "node scripts/audit_headings.js",
    "audit:toc": "node scripts/audit_toc_vs_headings.js",
    "toc:table": "node scripts/generate_toc_table.js",
    "fetch-api": "node scripts/fetch_stoplight.js",
    "fetch-api:cloud": "node scripts/fetch_stoplight.js --product cloud",
    "test": "node --test scripts/generate_combined.test.js scripts/fetch_fluidtopics.test.js scripts/snapshot.test.js scripts/check.test.js"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
